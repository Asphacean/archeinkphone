# FT5436 reports portrait 824x1648; the DSI mode is landscape 1648x824 and KWin rotates the
# output (panel orientation LEFT_UP) and touch alike, so hand libinput mode-space coordinates.
# KWin resets its own per-device Orientation at startup, hence udev rather than kcminputrc.
ATTRS{name}=="generic ft5x06*", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1"
