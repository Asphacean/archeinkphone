[Unit]
Description=Boox Palma 2 e-ink auto refresh (fb0 -> TCON)
After=multi-user.target
ConditionPathExists=/dev/fb0

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -e /dev/fb0 ] && exit 0; sleep 0.2; done; exit 1'
ExecStartPre=/bin/sh -c 'printf "\\033[?5h\\033[2J\\033[H" > /dev/tty1'
ExecStart=/usr/bin/python3 /usr/local/bin/epd_autorefresh.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
