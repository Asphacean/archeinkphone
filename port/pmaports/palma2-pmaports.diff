++		pins = "gpio2";
++		function = PMIC_GPIO_FUNC_NORMAL;
++		bias-pull-up;
++		input-enable;
++		power-source = <0>;
++	};
++};
++
++&pmk8350_pon {
++	status = "disabled";
++};
++
++&pmk8350_rtc {
++	status = "okay";
++};
