+/*
+ * Onyx Boox Palma 2 (sm6350, DSI video -> FPGA TCON): when the programmable
+ * fetch uses the whole vertical front porch, mainline starts the fetch on the
+ * first line after the active region (vtotal - vfp).  On this platform that
+ * makes the DSI video engine report VIDEO_MDP/lane FIFO over+underflow at every
+ * frame boundary, the TCON rejects every frame and ~50 % of link enables leave
+ * the data lanes in LP-11.  The stock kernel starts the fetch one line later
+ * (vtotal - vfp + 1).  dpu_prog_fetch_adj (lines, default -1) is applied to the
+ * number of VFP lines used for the fetch.
+ */
+static int dpu_prog_fetch_adj = -1;
+module_param(dpu_prog_fetch_adj, int, 0644);
