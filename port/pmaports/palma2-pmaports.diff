++	status = "okay";
++};
++
++&qupv3_id_1 {
++	status = "okay";
++};
++
++&uart9 {
++	status = "okay";
++};
++
++&ufs_mem_hc {
++	reset-gpios = <&tlmm 156 GPIO_ACTIVE_LOW>;
++
++	vcc-supply = <&vreg_l7e>;
++	vcc-max-microamp = <800000>;
++	vccq2-supply = <&vreg_l12a>;
++	vccq2-max-microamp = <800000>;
++
++	status = "okay";
++};
++
++&ufs_mem_phy {
++	vdda-phy-supply = <&vreg_l18a>;
++	vdda-pll-supply = <&vreg_l22a>;
++
++	status = "okay";
++};
++
++&tlmm {
++	/* 13-16: fingerprint SPI (secure). FP4 also reserves 56-57, but on Palma 2 those are the FPGA SPI pins. */
++	gpio-reserved-ranges = <13 4>;
++};
++
++&usb_1 {
++	status = "okay";
++};
++
++&usb_1_dwc3 {
++	/* stage 1: plain gadget, no Type-C role switching yet */
++	dr_mode = "peripheral";
++	maximum-speed = "high-speed";
++};
++
++&usb_1_hsphy {
++	vdd-supply = <&vreg_l18a>;
++	vdda-pll-supply = <&vreg_l2a>;
++	vdda-phy-dpdm-supply = <&vreg_l3a>;
++
++	status = "okay";
++};
++
++&usb_1_qmpphy {
++	vdda-phy-supply = <&vreg_l16a>;
++	vdda-pll-supply = <&vreg_l22a>;
++
++	status = "okay";
++};
++
++/*
++ * Stage 2 (display), from the reverse-engineered stock driver (PLAN.md "Фаза 1b"):
++ *
++ * &i2c7 { lfe5u_tcon: tcon@34 { compatible = "onyx,lfe5u-tcon"; reg = <0x34>;
++ *     vdd1v8-supply = <&vreg_l5a>; vdd1v2-supply = <&vreg_l3e>;
++ *     reset-gpios = <&tlmm 122 GPIO_ACTIVE_LOW>; standby-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
++ *     program-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>; init-gpios = <&tlmm 9 GPIO_ACTIVE_LOW>;
++ *     done-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>; pwr-30v-gpios = <&tlmm 97 GPIO_ACTIVE_HIGH>;
++ *     pwr-12v-core-gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>; onyx,vcom = <200>; }; };
++ * &mdss_dsi0 { vdda-supply = <&vreg_l22a>; panel@0 { compatible = "onyx,palma2-tcon-panel";
++ *     1648x824@60, hfp 40 hbp 40 hsw 20, vfp 10 vbp 6 vsw 2, 4 lanes RGB888 video non-burst,
++ *     reset-gpios = <&pm6150l_gpios 9 GPIO_ACTIVE_LOW>; DCS 0x11 on / 0x10 off }; };
++ * &mdss_dsi0_phy { vdds-supply = <&vreg_l18a>; };
++ */
