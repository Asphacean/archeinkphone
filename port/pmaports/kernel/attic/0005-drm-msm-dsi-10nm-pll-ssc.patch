From: Palma 2 bring-up <none@none>
Subject: [PATCH] drm/msm/dsi: 10nm PLL SSC knob (stock Palma 2 runs with SSC)

---
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_10nm.c	2026-10-26 16:39:59
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_10nm.c	2026-10-26 16:39:59
@@ -164,13 +164,18 @@
  */
 static struct dsi_pll_10nm *pll_10nm_list[DSI_MAX];
 
+/* Palma 2: stock Boox kernel runs the DSI PLL with down-spread SSC (SSC_CONTROL=SSC_EN) */
+static bool pll_ssc = true;
+module_param(pll_ssc, bool, 0644);
+MODULE_PARM_DESC(pll_ssc, "enable DSI 10nm PLL spread spectrum (stock: on)");
+
 static void dsi_pll_setup_config(struct dsi_pll_config *config)
 {
 	config->ssc_freq = 31500;
 	config->ssc_offset = 5000;
 	config->ssc_adj_per = 2;
 
-	config->enable_ssc = false;
+	config->enable_ssc = pll_ssc;
 	config->ssc_center = false;
 }
 
