From: Palma 2 bring-up <none@none>
Subject: [PATCH] clk: qcom: dispcc-sm6350: keep mdss_gdsc always on (palma2: required, the e-ink TCON shows black without it)

---
--- a/drivers/clk/qcom/dispcc-sm6350.c	2026-10-26 17:27:17
+++ b/drivers/clk/qcom/dispcc-sm6350.c	2026-10-26 17:27:17
@@ -692,7 +692,8 @@
 		.name = "mdss_gdsc",
 	},
 	.pwrsts = PWRSTS_OFF_ON,
-	.flags = RETAIN_FF_ENABLE,
+	/* Palma 2: keep MDSS powered; with RETAIN_FF_ENABLE alone the FPGA TCON gets black frames (bisected 27.10) */
+	.flags = RETAIN_FF_ENABLE | ALWAYS_ON,
 };
 
 static struct clk_regmap *disp_cc_sm6350_clocks[] = {
