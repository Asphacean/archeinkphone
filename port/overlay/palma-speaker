#!/usr/bin/env python3
"""palma-speaker on|off: program the AW87390 speaker PA (i2c10 @0x58) from the stock aw87xxx_acf.bin profiles
(0 = Music, 11 = Off). Mainline aw87390 can't parse that ACF, so the card has no PA aux-dev and this does it.
ACF entry (64 B @0x50): u16 profile @+0x1a, u32 type/size/offset @+0x1c; blob = 64 B header, u32 count @+0x3c,
then (reg, val) byte pairs; reg 0xfe/0xff = delay in ms (GUESS from the stock data, harmless either way)."""
import fcntl, glob, os, struct, sys, time
ACF = '/lib/firmware/aw87390_acf.bin'

def profile(want):
    d = open(ACF, 'rb').read()
    for o in range(0x50, len(d) - 0x40, 0x40):
        if d[o + 4:o + 11] == b'aw87390' and struct.unpack_from('<H', d, o + 0x1a)[0] == want:
            _, size, off = struct.unpack_from('<III', d, o + 0x1c)
            blob = d[off:off + size]
            n = struct.unpack_from('<I', blob, 0x3c)[0]
            return [(blob[0x40 + 2 * i], blob[0x41 + 2 * i]) for i in range(n)]
    sys.exit('profile %d not found' % want)

def main():
    pairs = profile(0 if sys.argv[1:] == ['on'] else 11)
    bus = next('/dev/' + os.path.basename(x) for x in glob.glob('/sys/bus/i2c/devices/i2c-*') if '990000' in os.path.realpath(x))
    fd = os.open(bus, os.O_RDWR); fcntl.ioctl(fd, 0x0706, 0x58)     # I2C_SLAVE_FORCE: the aw87390 driver owns the client
    for reg, val in pairs:
        if reg >= 0xfe: time.sleep(val / 1000); continue
        os.write(fd, bytes([reg, val]))
    os.write(fd, b'\x01'); print('SYSCTRL', hex(os.read(fd, 1)[0]))

if __name__ == '__main__':
    assert profile.__doc__ is None
    main()
